      "slug": "sweet-potato-spinach",
      "title": "Sweet Potato & Spinach Puree",
      "description": "This Sweet Potato & Spinach puree has the nutritional WOW factor. Containing not just one, but two superfood powerhouses, this recipe is a great way to hit little one's nutritional targets in the most tasty way!",
      "featured_image": "https://www.annabelkarmel.com/wp-content/uploads/2023/11/Sweet-potato-spinach-min-scaled-optimized.jpg",
      "featured_image_alt": "Sweet potato and spinach puree",
      "prep_time": "5 mins",
      "cook_time": "15 mins",
      "servings": "",
      "difficulty": "easy",
      "suitable_for_freezing": true,
      "app_exclusive": true,
      "ingredients": [
        {
          "title": "",
          "items": [
            "150g sweet potato, peeled and diced",
            "40g fresh baby spinach"
          ]
        }
      ],
      "method": [
        {
          "text": "Put the sweet potato into a steamer. Steam for 15 minutes until tender."
        },
        {
          "text": "Add the spinach and steam for a further 2 minutes."
        },
        {
          "text": "Blend until smooth using a stick blender."
        }
