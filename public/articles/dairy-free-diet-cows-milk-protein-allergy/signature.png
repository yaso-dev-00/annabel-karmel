/* 12-03-2025 Ol Ul*/
.elementor-widget-text-editor ol,
.dynamic-content-for-elementor-acf ol
{
    counter-reset: list-counter !important; 
    padding-left: 20px !important;
}

.elementor-widget-text-editor ol li,
.dynamic-content-for-elementor-acf ol li
{
    counter-increment: list-counter !important; 
    list-style: none !important;
    position: relative !important;
    padding-left: 25px !important;
}

.elementor-widget-text-editor ol li::before,
.dynamic-content-for-elementor-acf ol li::before
{
    content: counter(list-counter) "." !important; 
    position: absolute !important;
    left: 0 !important;
}

.elementor-widget-text-editor ul,
.dynamic-content-for-elementor-acf  ul
{
    list-style-type: disc !important; 
    padding-left: 20px !important;
}

.elementor-widget-text-editor ul li,
.dynamic-content-for-elementor-acf  ul li
{
    margin-bottom: 10px !important;
    position: relative !important;
    padding-left: 20px !important;
}

.elementor-widget-text-editor ul li::before,
.dynamic-content-for-elementor-acf  ul li::before
{
    content: "•" !important; 
    position: absolute !important;
    left: 0 !important;
}

