      "seo_title": "Sample Article | Annabel Karmel",
      "seo_description": "A short demo article for the Articles CMS.",
      "content_blocks": [
        {
          "id": "b001-hero",
          "type": "hero",
          "order": 0,
          "data": {
            "headline": "Breastmilk Storage Tips",
            "subheadline": "Everything you need to know about storing pumped breastmilk safely",
            "image_url": "/advice-category/breastfeeding-advice/breastmilk-storage.jpg",
            "image_alt": "Breastmilk storage advice",
            "background_color": "#f6e9ef",
            "image_width": "873px",
            "image_height": "480px"
          }
        },
        {
          "id": "b002-lead",
          "type": "rich_text",
          "order": 1,
          "data": {
            "html": "<p><strong>Here is the most important information on storing pumped breastmilk correctly.</strong> Use sterilised equipment whilst pumping and to store your milk in.</p>",
            "variant": "lead"
          }
        },
        {
          "id": "b003-heading",
          "type": "heading",
          "order": 2,
          "data": {
            "level": "h2",
            "text": "Storage guidelines"
          }
        },
        {
          "id": "b004-list",
          "type": "list",
          "order": 3,
          "data": {
            "ordered": false,
            "style": "plain",
            "items": [
              "Use sterilised equipment whilst pumping and to store your milk in. Milk storage bags are space-saving and easy to label.",
              "Milk at room temperature lasts 6 hrs.",
              "Milk in a cooler bag will last 24hrs.",
              "Milk stored in the refrigerator will last 3–6 days.",
              "Label the date and time to store correctly."
            ]
          }
        },
        {
          "id": "b005-callout",
          "type": "callout",
          "order": 4,
          "data": {
            "variant": "tip",
            "title": "Top tip",
            "body": "<p>When you want to reheat milk, thaw frozen milk in a warm water bath first, then reheat in a bottle warmer.</p>"
          }
        },
        {
          "id": "b006-image-text",
          "type": "image_text",
          "order": 5,
          "data": {
            "image_src": "/advice-category/breastfeeding-advice/pumping.jpg",
            "image_alt": "Pumping breast milk",
            "image_position": "left",
            "heading": "Building a pumping routine",
            "body": "<p>Regular pumping every 2–3 hours helps build a good supply. Have baby or a photo nearby to help with letdown — oxytocin release makes milk flow more easily.</p>",
            "image_first": true
          }
        }
      ],
