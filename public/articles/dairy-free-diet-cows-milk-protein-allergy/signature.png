.ann_banner_slider .swiper-slide[data-swiper-slide-index="1"] .elementor-button.elementor-slide-button.elementor-size-sm {
    background-color: #8D8575;
    border-color:transparent;
}

.ann_banner_slider .swiper-slide[data-swiper-slide-index="2"] .elementor-button.elementor-slide-button.elementor-size-sm {
    background-color: #6E9CA5;
    border-color:transparent;
}
.ann_lateset_recipe_slider_wrap .dce-posts-container .dce-post-image .dce-img img{
	  height: 370px;
	object-fit:cover;
}
.pink_btn .elementor-button:hover svg path {
  stroke: #b34769 !important;
	fill: transparent;
}
.brown_btn  .elementor-button:hover svg path {
  stroke: #8d8575 !important;
	fill: transparent;
}
.green_btn .elementor-button:hover svg path {
  stroke: #6e9ca5 !important;
	fill: transparent;
}

.site-header-above-section-right .site-header-above-section-right-center.site-header-section.ast-flex.ast-grid-right-center-section {
    display: none;
}
.site-header-above-section-left.site-header-section.ast-flex.site-header-section-left {
